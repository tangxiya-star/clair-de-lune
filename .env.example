# Quiver Arrow secret. Server-side only — never put this in client code.
# Docs name it QUIVERAI_API_KEY; either name works.
QUIVER_API_KEY=
QUIVERAI_API_KEY=

# Optional. Overrides the Arrow model id without a code change — the roster
# moves (arrow-2 was withdrawn mid-event). Defaults to arrow-1.1.
QUIVER_MODEL=
